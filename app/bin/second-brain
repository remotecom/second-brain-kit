#!/bin/bash
# second-brain — start/open the app, or run a command (setup, doctor, ...).
#   second-brain            start the app if it is not running, open its window
#   second-brain <command>  see `second-brain help`
set -euo pipefail
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE="${SECOND_BRAIN_STATE_DIR:-$HOME/.second-brain}"
# node: PATH first, then the usual install places (a login shell may not have nvm).
NODE="$(command -v node || true)"
for n in /opt/homebrew/bin/node /usr/local/bin/node "$HOME/.volta/bin/node"; do [ -n "$NODE" ] && break; [ -x "$n" ] && NODE="$n"; done
[ -n "$NODE" ] || { echo "second-brain: node not found. Install Node 18 or newer: brew install node, or https://nodejs.org" >&2; exit 1; }

if [ "${1:-open}" != "open" ]; then SECOND_BRAIN_NODE="$NODE" exec "$NODE" "$APP_DIR/cli.js" "$@"; fi

[ -f "$STATE/settings.json" ] || [ -n "${SECOND_BRAIN_VAULT:-}" ] || { echo "Not set up yet. Run: $0 setup"; exit 1; }
PORT="${SECOND_BRAIN_PORT:-$("$NODE" -e 'try{console.log(require(process.argv[1]).port||19300)}catch{console.log(19300)}' "$STATE/settings.json")}"
mkdir -p "$STATE"
if ! lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  SECOND_BRAIN_PORT="$PORT" nohup "$NODE" "$APP_DIR/server.js" >>"$STATE/server.log" 2>&1 &
  for _ in $(seq 1 30); do lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 && break; sleep 0.2; done
fi
# SECOND_BRAIN_NO_OPEN=1 starts the server only (the installer's test run).
[ -z "${SECOND_BRAIN_NO_OPEN:-}" ] || { echo "Second Brain on http://localhost:$PORT (log: $STATE/server.log)"; exit 0; }
# Its own window: a Chrome app window (no tabs, no URL bar) if Chrome is there,
# else the default browser. The window uses your REGULAR Chrome profile
# ("Default", or SECOND_BRAIN_CHROME_PROFILE, e.g. "Profile 2"). A separate
# --user-data-dir started a second Chrome with the same bundle id: links from
# the app, and from other apps (Slack, Mail), then opened in that signed-out
# Chrome. With one Chrome, links open in tabs where you are signed in.
CHROME=""
for c in "/Applications/Google Chrome.app" "$HOME/Applications/Google Chrome.app"; do
  [ -x "$c/Contents/MacOS/Google Chrome" ] && { CHROME="$c/Contents/MacOS/Google Chrome"; break; }
done
if [ -n "$CHROME" ]; then
  # A running Chrome takes the request and opens the window; this call returns.
  nohup "$CHROME" --profile-directory="${SECOND_BRAIN_CHROME_PROFILE:-Default}" --app="http://localhost:$PORT" >/dev/null 2>&1 &
else
  open "http://localhost:$PORT"
fi
echo "Second Brain on http://localhost:$PORT (log: $STATE/server.log)"
